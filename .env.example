# Neon Postgres (pooled connection string from the Vercel integration)
DATABASE_URL=

# Optional direct/unpooled URL for drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# Vercel Blob store token
BLOB_READ_WRITE_TOKEN=

# Random 32+ byte secret used for the admin session and IP hashing
AUTH_SECRET=

# Single admin account
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Resend email notifications
RESEND_API_KEY=
BOOKING_FROM_EMAIL=bookings@your-domain.com
BOOKING_NOTIFY_EMAIL=you@your-domain.com

# Stripe deposits (test keys on local/preview, live keys in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public production URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.com
